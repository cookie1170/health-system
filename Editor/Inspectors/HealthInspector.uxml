<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style
            src="project://database/Assets/HealthSystem/Editor/Inspectors/CookieUtilsInspector.uss?fileID=7433441132597879392&amp;guid=9e30abdaa34a491f8eca576eacd027e6&amp;type=3#CookieUtilsInspector"/>
    <ui:VisualElement name="DataObjectInspectorPanel" class="data-inspector">
        <ui:Foldout text="SamplePlayer_HealthData" name="DataTitle" view-data-key="DataTitle" class="title"
                    style="font-size: 16px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="DataObject" class="panel">
        <ui:Foldout text="Data" name="DataTitle" view-data-key="DataFoldout" class="title">
            <uie:PropertyField name="DataObject" binding-path="data" label="Data object"/>
            <ui:Button text="Create data object" name="GenerateDataObject" class="title"
                       style="height: 40px; margin-top: 8px; margin-right: 8px; margin-bottom: 8px; margin-left: 8px;"/>
        </ui:Foldout>
    </ui:VisualElement>
    <ui:VisualElement name="Events" class="panel" style="flex-grow: 1;">
        <ui:Foldout text="Events" name="EventsTitle" view-data-key="EventsFoldout" class="title">
            <uie:PropertyField binding-path="onHit" name="OnHit"
                               style="margin-top: 8px; margin-right: 8px; margin-bottom: 8px; margin-left: 8px;"/>
            <uie:PropertyField name="OnDeath" binding-path="onDeath"
                               style="margin-top: 8px; margin-right: 8px; margin-bottom: 8px; margin-left: 8px;"/>
        </ui:Foldout>
    </ui:VisualElement>
</ui:UXML>
